<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="zhiguang-be"/>
    <springProperty scope="context" name="LOGSTASH_HOST" source="logging.logstash.host" defaultValue="127.0.0.1"/>
    <springProperty scope="context" name="LOGSTASH_PORT" source="logging.logstash.port" defaultValue="5000"/>

    <appender name="CONSOLE_TEXT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp/>
                <logLevel/>
                <threadName/>
                <loggerName/>
                <message/>
                <arguments/>
                <stackTrace/>
                <pattern>
                    <pattern>{"service":"${APP_NAME}"}</pattern>
                </pattern>
            </providers>
        </encoder>
    </appender>

    <appender name="LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>${LOGSTASH_HOST}:${LOGSTASH_PORT}</destination>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp/>
                <logLevel/>
                <threadName/>
                <loggerName/>
                <message/>
                <arguments/>
                <stackTrace/>
                <pattern>
                    <pattern>{"service":"${APP_NAME}"}</pattern>
                </pattern>
            </providers>
        </encoder>
    </appender>

    <springProfile name="elk">
        <!-- 框架日志（Spring/Tomcat/Hibernate 等）只输出到控制台，不发 logstash，避免噪音 -->
        <root level="WARN">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
        <!-- RAG 业务包：INFO 起发 logstash + 控制台，保证 ELK 里只看到业务步骤 -->
        <logger name="com.tongji.llm" level="INFO" additivity="false">
            <appender-ref ref="LOGSTASH"/>
            <appender-ref ref="CONSOLE_JSON"/>
        </logger>
    </springProfile>

    <springProfile name="!elk">
        <root level="INFO">
            <appender-ref ref="CONSOLE_TEXT"/>
        </root>
    </springProfile>
</configuration>
